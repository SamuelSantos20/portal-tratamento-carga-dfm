#!/bin/sh
set -eu
if command -v py >/dev/null 2>&1; then
  exec py -3 scripts/verificar_commit_confidencial.py --pre-push
elif command -v python3 >/dev/null 2>&1; then
  exec python3 scripts/verificar_commit_confidencial.py --pre-push
else
  echo "Python 3 necessario para verificar confidencialidade. Push bloqueado." >&2
  exit 1
fi
